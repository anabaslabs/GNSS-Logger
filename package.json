{
  "name": "gnss-logger",
  "main": "expo-router/entry",
  "version": "1.5.0",
  "scripts": {
    "clean": "pnpm clean:android",
    "clean:android": "cd android && gradlew clean -x :app:externalNativeBuildCleanDebug -x :app:externalNativeBuildCleanRelease",
    "build": "pnpm prebuild && pnpm build:android",
    "build:android": "cd android && gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "prebuild": "expo prebuild",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write --end-of-line auto \"{app,components,constants,hooks,store}/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/ysabeau-infant": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.8",
    "@tabler/icons-react-native": "^3.41.1",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-intent-launcher": "^13.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "expo-dev-client": "~6.0.21",
    "expo-build-properties": "^57.0.6",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2"
  },
  "private": true
}